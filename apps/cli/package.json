{
  "name": "ts-launch-blueprint",
  "version": "0.2.0",
  "description": "CLI tools for project search and selection - TypeScript port of py-launch-blueprint",
  "keywords": [
    "blueprint",
    "cli",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "author": "Steve Morin <steve.morin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smorinlabs/ts-launch-blueprint.git",
    "directory": "apps/cli"
  },
  "bin": {
    "ts-projects": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-package-files.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.3.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "yocto-spinner": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ts-launch-blueprint/core": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
