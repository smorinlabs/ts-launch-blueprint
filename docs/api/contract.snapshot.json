{
  "schemaVersion": 1,
  "version": "0.0.0",
  "procedures": {
    "projects.get": {
      "type": "query",
      "inputOptional": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "workspace": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["id", "name", "workspace"],
            "additionalProperties": false
          }
        },
        "required": ["project"],
        "additionalProperties": false
      }
    },
    "projects.list": {
      "type": "query",
      "inputOptional": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceName": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "workspace": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": ["name"],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["id", "name", "workspace"],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["projects", "nextCursor"],
        "additionalProperties": false
      }
    }
  }
}
