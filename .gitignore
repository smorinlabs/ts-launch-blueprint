# Node-generated files
node_modules/
dist/
# README.md/LICENSE copied next to the published package by its build
# (apps/cli/scripts/copy-package-files.mjs); the repo-root files are canonical.
apps/cli/README.md
apps/cli/LICENSE
# Temporary probe files written by tests/boundaries.test.ts (always removed;
# ignored in case a crashed run leaves one behind).
**/__boundary-probe-*
build/
*.tsbuildinfo

# NOTE: pnpm-lock.yaml IS committed (D-035, amending D-011(5)) — the inverse of
# the Python source, which gitignored uv.lock ("remove if you want to pin
# versions"). Node CI (pnpm install --frozen-lockfile, setup-node caching, the
# GitHub dependency graph) is designed around a committed lockfile; delete the
# lockfile and add it here if you want unpinned installs.

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Caches
.cache/

# Secrets
.env
.env.*
!.env.example

# Local Claude Code session settings (machine-specific; untracked copies
# must never trip oxfmt format-check — see .oxfmtrc.json ignorePatterns)
.claude/settings.local.json
