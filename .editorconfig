# EditorConfig (https://editorconfig.org) — cross-editor baseline (P05).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,mts,cts,js,mjs,cjs,css,html}]
indent_size = 2

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[Makefile]
indent_style = tab

# Preserve Markdown hard breaks (`<two-spaces>\n`) and 2-space list indent (oxfmt).
[*.md]
indent_size = 2
trim_trailing_whitespace = false
