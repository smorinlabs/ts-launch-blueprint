{
  "name": "ts-launch-blueprint-workspace",
  "version": "0.1.3",
  "private": true,
  "description": "pnpm workspace root for ts-launch-blueprint (D-040): packages/core + apps/cli",
  "license": "MIT",
  "author": "Steve Morin <steve.morin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smorinlabs/ts-launch-blueprint.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter ts-launch-blueprint build",
    "typecheck": "sh scripts/typecheck.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.6.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.70.0",
    "oxlint": "^1.74.0",
    "pino-pretty": "^13.2.0",
    "publint": "^0.3.21",
    "tsdown": "0.23.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.9",
      "source-map-js": "^1.2.2"
    }
  }
}
