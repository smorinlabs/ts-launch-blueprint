{
  "name": "ts-launch-blueprint",
  "version": "0.1.3",
  "description": "CLI tools for project search and selection - TypeScript port of py-launch-blueprint",
  "keywords": [
    "blueprint",
    "cli",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "author": "Steve Morin <steve.morin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smorinlabs/ts-launch-blueprint.git"
  },
  "bin": {
    "ts-projects": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.3.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.7.0",
    "yocto-spinner": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "oxfmt": "0.67.0",
    "oxlint": "^1.74.0",
    "publint": "^0.3.21",
    "tsdown": "0.23.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d"
}
