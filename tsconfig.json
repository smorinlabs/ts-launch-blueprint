// Root typecheck over the whole workspace: `just typecheck` stays one
// `tsc --noEmit` (D-013(4)). Packages extend the same base for the editor
// and tsdown.
{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/tests/**/*.ts",
    "apps/*/tsdown.config.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
