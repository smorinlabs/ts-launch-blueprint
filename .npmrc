# pnpm configuration (D-035). pnpm 10 does NOT read package.json `devEngines`
# for package-manager enforcement, so the `packageManager` field plus these
# three settings are what pin and enforce the package manager here (the
# Corepack replacement — Corepack is being removed from Node in a future
# major). devEngines.runtime (node >=24) stays in package.json for the Node
# floor; only the npm packageManager entry was removed.
#
# managePackageManagerVersions: pnpm self-manages its version from the
#   `packageManager` field (downloads/uses pnpm@10.34.3), Corepack-free.
# packageManagerStrict: refuse to run if a different package manager or a
#   mismatched pnpm version is invoked.
# packageManagerStrictVersion: require the exact version in `packageManager`,
#   not just a compatible range.
managePackageManagerVersions=true
packageManagerStrict=true
packageManagerStrictVersion=true
