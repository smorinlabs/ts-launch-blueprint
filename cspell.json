{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "enableGlobDot": true,
  "useGitignore": true,
  "ignorePaths": [
    ".git/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "CONTRIBUTORS.md",
    ".contributors.jsonl",
    "docs/port/**",
    "projects/**",
    "press/press-receipt.toml"
  ],
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "smorinlabs/difftree-action",
    "smorinlabs/template-press",
    "AKIAIOSFODNN7EXAMPLE",
    "dontAsk",
    "\\\\?x1b\\[[0-9;]*m"
  ],
  "words": [
    "anthropics",
    "arethetypeswrong",
    "artipacked",
    "attw",
    "autodoc",
    "buildx",
