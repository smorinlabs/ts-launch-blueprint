{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "enableGlobDot": true,
  "useGitignore": true,
  "ignorePaths": [
    ".git/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "CONTRIBUTORS.md",
    ".contributors.jsonl",
    "docs/port/**",
    "projects/**",
    "press/press-receipt.toml"
  ],
  "ignoreRegExpList": ["Urls", "Email", "smorinlabs/difftree-action", "smorinlabs/template-press"],
  "words": [
    "artipacked",
    "attw",
    "autodoc",
    "coderabbit",
    "codespell",
    "commitlint",
    "coverable",
    "dcoapp",
    "depcruise",
    "difftree",
    "downloaders",
    "dryrun",
    "eamodio",
    "elif",
    "esac",
    "eventloop",
    "examplecli",
    "extensionless",
    "firestore",
    "flox",
    "footgun",
    "getenv",
    "gitlint",
    "gitmessage",
    "gpgsign",
    "greptile",
    "healthcheck",
    "healthz",
    "hono",
    "iface",
    "inlines",
    "isort",
    "jaegertracing",
    "justfiles",
    "lefthook",
    "libgit",
    "llms",
    "makefiles",
    "misformatted",
    "mktemp",
    "mypy",
    "npmjs",
    "nvmrc",
    "pasteable",
    "pipefail",
    "prepush",
    "publint",
    "pycodestyle",
    "pyflakes",
    "pyperclip",
    "pytest",
    "pyupgrade",
    "pyupio",
    "readyz",
    "refetches",
    "repoint",
    "retarget",
    "rhysd",
    "shellcheck",
    "sigpipe",
    "smol",
    "smorinlabs",
    "stylesheet",
    "tamasfe",
    "taplo",
    "testpaths",
    "tlsv",
    "toctree",
    "tokenless",
    "tokenlessly",
    "toplevel",
    "trpc",
    "tsdown",
